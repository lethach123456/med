# Instance-specific credentials
/config/database.runtime.php

# Local machine files and recoverable copies
.DS_Store
/backups/

# Runtime JSON search indexes. The directory itself remains in Git so a fresh
# deployment has a writable, predictable cache location.
/storage/cache/*.json
/storage/cache/*.lock
/storage/cache/*.invalidated
!/storage/cache/.gitkeep

# AI handbook illustrations are runtime CMS uploads, not deploy-time assets.
/uploads/handbook/

# Bulk image-branding ledger and generated copies belong to the hosting instance.
/storage/image-branding/
/uploads/library/medreview-branded/
