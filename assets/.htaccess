# Static assets only. No page, admin, API or session response is cached here.
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # Fingerprinted CSS/image files and versioned vendor fonts never change in place.
  <FilesMatch "(?:public-(?:shell|home)\.[a-f0-9]{24}\.css|[a-f0-9]{24}-[0-9]+\.webp|phosphor\.css|\.woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/css application/javascript text/javascript image/svg+xml
</IfModule>
